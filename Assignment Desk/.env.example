# =========================================================================
# Assignment Desk - Environment Configuration Template (.env.example)
# =========================================================================

# -------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Next.js)
# -------------------------------------------------------------------------
# Local or production URL of the ASP.NET Core API Backend
BACKEND_URL=http://localhost:5145

# -------------------------------------------------------------------------
# BACKEND CONFIGURATION (ASP.NET Core / PostgreSQL)
# -------------------------------------------------------------------------
# You can override the appsettings.json Connection String via environment variables:
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=AssignmentManagementDb;Username=postgres;Password=YOUR_DATABASE_PASSWORD

# JWT configuration overrides if necessary:
Jwt__Key=ThisIsMyVerySecretKeyForAssignmentDesk12345
Jwt__Issuer=AssignmentDesk
Jwt__Audience=AssignmentDeskUsers
Jwt__ExpiryMinutes=60
